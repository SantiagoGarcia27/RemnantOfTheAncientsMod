Mods: {
	RemnantOfTheAncientsMod: {
		ChatMessage.CalamityReforgeConfig:
			'''
			Advertencia
			Los reforges custom del mod fueron deshabilitados por una configuaración del Calamity Mod.
			Para solucionarlo por favor desactive la opción "{0}" en la configuración del calamity
			'''

		SetBonus: {
			Tuxonite:
				'''
				Puedes entrar en sigilo de manera aleatoria
				Aumenta las habilidades a distancia 
				Reduce la posibilidad de que los enemigos te detecten
				'''
			Daylight:
				'''
				Durante el día, duplica la regeneración de vida.
				Por la noche, incrementementa le maná máximo en 20.
				La margarita brillante no consume maná.
				'''
			Flinx:
				'''
				{$CommonItemTooltip.IncreasesMaxLifeBy}
				Invoca un súbdito de copito para que luche por ti.
				'''
			TrueHallowed: Te vuelves inmune e invocas clones tras golpear a un enemigo.
		}

		Messages: {
			Reaper: {
				On: Bienvenido al infierno, ahora eres un segador.
				Off: Tu alma es libre... por ahora.
			}
		}

		TownNPCMood: {
			Time_Wizard: {
				DisplayName: Mago temporal
				Content: Me siento muy bien ahora mismo.
				NoHome: Me gustaria mucho una casa, los monstruos coloridos me asustan.
				LoveSpace: Amo este lugar, tengo mucho espacio para practicar magia!
				FarFromHome: Podrias llevarme a mi hogar?
				DislikeCrowded: Hay demasiadas personas alrededor, me cuesta concentrarme en mis estudios.
				HateCrowded: No puedo probar mis hechizos con tantas personas cerca!
				LikeBiome: "{BiomeName} es un gran lugar para vivir"
				LoveBiome: Me encanta {BiomeName}.
				DislikeBiome: Hace demasiado frío en la {BiomeName}, Me estoy congelando!
				HateBiome: Es dificil poder observar el cielo mientras soy atacado por mounstros en {BiomeName}.
				LikeNPC: Puedo respetar a {NPCName} como una fuente de aprendizaje!
				LoveNPC: Crees que {NPCName} me notó?
				DislikeNPC: Honestamente no me caé bien {NPCName}.
				HateNPC: Detesto totalmente a{NPCName}, no puedo ni verlo.
			}
		}

		Dialogue: {
			Time_Wizard: {
				WizardDialogue: ¿{0}?, Él es un gran amigo mio, recuerdo cuando estudiamos en la escuela de hechizeria.
				ClotierDialogue:
					'''
					Oh? You're approaching me? Instead of running away, you're coming right to me?
					Even Though your clothier, {0}, told you the secret of The World, *dead {0} pics*
					like an exam student scrambling to finish the problems on an exam until the last moments before the chime?
					'''
				DayDialogue1:
					'''
					Es un bello día alla afuera, los pajaros cantan, las flores florecen...
					Sería una pena que se hiciera de noche de repente no?.
					'''
				DayDialogue2: Oh hola {0}, ¿como está tu día?.
				NightDialogue1: Es una hermosa noche, ¿que dirian los vecinos si lo hacemos de día?.
				NightDialogue2: Oh hola {0}, ¿como estás en esta noche?.
				JudmnetDialogue1: Es un arma interesante,permite que el juicio de un ser determinado caiga sobre tus enemigos.
				NoBeeDefeatedDialogue1: !Que moletisa estas abejas¡ ¿podrias encargarte de estas?
				GenericDialog1: Lindo reloj.
				ErrorDialgog: Error en la realidad, algo salió mal, si ves este mensaje avisale a la tortuga ;)
			}

			MinerSoul: {
				CommonDialogue1: Hola, podrias darme una picota simple?
				CommonDialogue2:
					'''
					Recuerdo esos días en los que podía picar oro por todos lados.
					Pero ahora perdi mi pico de hierro, ¿Podrias conseguirme uno?
					'''
				ThanksDialogue1: Muchas gracias .....
				UpgradeItem: Eh mejorado tu objeto...
			}
		}

		UI: {
			Buttoms: {
				DeliverPickaxe: Entregar pico
				UpgradeItem: Mejorar {0}
				SkipDay: Skip day
			}

			ReaperTitle: Almas

			Couldowns: {
				CouldownBar: "{0}s"
				AmmoBar: "{0}"
			}

			AscendedReforgesTitle: Reforges Ascendidos
			AscendedReforgesText:
				'''
				Para que un reforge ascienda a un nivel superior debes cumplir con los siguientes requisitos:

				-Un Duende chapucero imbuido del brillante poder del fulgor.

				-Un arma reforjada con un nivel máximo de reforja (ejemplo: Legendario)

				-Y por ultimo una moneda para pagar el trabajo, esta debe ser una moneda terra

				Una vez que lo tengas todo, tu próxima reforja podrá ascender.
				'''
		}

