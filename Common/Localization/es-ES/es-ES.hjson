				LagReducer: {
					Label: Reductor de Lag
					Tooltip:
						'''
						Reduce los aspectos gráficos del mod para mejorar el rendimiento.
						0 - Desactivado
						1 - 50% de particulas
						2 - 25% de particulas
						3 - Particulas desactivadas
						'''
				}

				VanillaWeaponsChangesConf: {
					Label: Cambios a armas vanilla
					Tooltip:
						'''
						Activa los cambios de balance a los objetos del juego base
						Desactive esta opción si genera incompativilidad con otro mod.
						'''
				}

				DropTombstomOnDeadtConf: {
					Label: Dejar tumbas al morir
					Tooltip:
